logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor & OS Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vite / Testing caches
.vite/
*.tmp
*.temp
