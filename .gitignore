# ==========================================
# Root .gitignore - Holy Guider (holyguider.com)
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Production Builds
dist/
frontend/dist/
build/
out/

# Environment Variables & Secrets (Keep .env.example safe!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
frontend/.env.production
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Temporary / Scratch files & Zips
scratch/
*.tmp
*.temp
*.zip

