node_modules/
package-lock.json.bak

# Environment Variables & Secrets
.env
.env.*
.env.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor & OS Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
