# Server Port
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/spiritual_ai_db

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional AI Credentials (AICredits / Gemini API)
AICREDITS_API_KEY=your_aicredits_or_gemini_api_key
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_MODEL=google/gemini-2.5-flash-lite
GEMINI_API_KEY=your_google_gemini_api_key

# Frontend URL(s) for CORS — comma-separated if you have more than one
# (e.g. a Vercel preview + your production domain). REQUIRED in production:
# with this unset, cross-origin browser requests are blocked by default.
CLIENT_URL=http://localhost:5173

# Secret used to sign login session tokens (JWTs). REQUIRED in production —
# generate a long random value, e.g.: openssl rand -hex 48
# If left unset, the server will generate a temporary one at startup and log
# a warning; all sessions will be invalidated on every restart.
JWT_SECRET=

# Admin Access Config. ADMIN_SECRET_KEY has NO default — admin login is
# disabled until you set a strong, random passcode here. Do not reuse an
# example/demo value in production. ADMIN_EMAIL is the ONLY email the
# passcode can ever promote to admin — it is no longer accepted from the
# client, so both of these must be set together for admin login to work.
ADMIN_SECRET_KEY=
ADMIN_EMAIL=admin@holyguider.com

# Guest ("Continue without signing in") sessions are disabled automatically
# in production to prevent unlimited anonymous account creation. Set this to
# "true" only if you intentionally want guest checkout enabled in production.
# Guests can NOT use the AI: asking requires signing in with Google.
ALLOW_GUEST_LOGIN=false

# The shared-passcode admin login (/api/auth/admin-login) is a "break glass"
# fallback and is disabled by default in production — the recommended path is
# signing in with Google as ADMIN_EMAIL, which needs no shared secret at all.
# Set this to "true" only if you need the passcode route, and only alongside
# an ADMIN_SECRET_KEY of at least 20 characters.
ADMIN_PASSCODE_LOGIN=false

# Node environment. Leave unset (or "development") for local dev — several
# safety checks above (weak admin key, guest cap, etc.) are
# only enforced when this is exactly "production". Your host (Render,
# Railway, Vercel...) usually sets this for you.
NODE_ENV=development

# Free consultations per account per rolling 24 hours (admins exempt).
# Every consultation costs an AI call, so keep this bounded.
DAILY_ASK_LIMIT=20

# Maximum number of NEW guest accounts created per rolling 24 hours, across
# all visitors (in addition to the per-IP limit on the login route itself).
GUEST_DAILY_CAP=200

# Set to "true" to also return the session token in the JSON body of
# login responses, for non-browser API clients (mobile apps, scripts,
# automated tests). The web app itself never needs this — it authenticates
# via the HttpOnly session cookie, which is safer against XSS.

# How many reverse-proxy hops to trust for the client's real IP
# (X-Forwarded-For), which per-IP rate limits depend on. Render/Railway/most
# PaaS hosts: 1. Behind your own nginx in front of that: 2. Defaults to 1 in
# production automatically; only set this if your setup needs a different
# number.
TRUST_PROXY=

# Session cookie behaviour. Defaults (lax / auto-secure in production) work
# for the common case of frontend + backend on the same site. Set
# COOKIE_SAMESITE=none (and COOKIE_SECURE=true) only if your frontend and
# backend are on different top-level domains — SameSite=None requires
# Secure and HTTPS.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Development convenience only: set to "true" to disable rate limiting
# while testing locally. Has no effect when NODE_ENV=production.
RATE_LIMIT_DISABLED=false

# Set to "true" to have the Content-Security-Policy report violations
# without blocking them (browser console + optional report-uri), useful
# while verifying Google sign-in in a new deployment before
# enforcing the policy for real.
CSP_REPORT_ONLY=false

