# Server Port
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/spiritual_ai_db

# Razorpay Test / Live Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional AI Credentials (AICredits / Gemini API)
AICREDITS_API_KEY=your_aicredits_or_gemini_api_key
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_MODEL=google/gemini-2.5-flash-lite
GEMINI_API_KEY=your_google_gemini_api_key

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
